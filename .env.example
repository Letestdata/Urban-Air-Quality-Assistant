# Urban Air AI - Environment Configuration

# Backend Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for Production, SQLite supported for development/testing)
DATABASE_URL=sqlite:///./urban_air.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urban_air_db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis / Cache (Optional in dev, uses in-memory LRU cache fallback)
REDIS_URL=redis://localhost:6379/0

# Environmental Data Integrations
OPEN_METEO_AQI_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPENAQ_API_KEY=
CPCB_API_KEY=

# AI Integration (OpenAI API / Gemini compatible endpoint)
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=10

# Google Maps Platform (Optional for real geocoding/routes)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Urban Air AI"
NEXT_PUBLIC_APP_TAGLINE="Breathe Smarter. Live Healthier."
